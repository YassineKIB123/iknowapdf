{
  "name": "pdftool",
  "compatibility_date": "2026-10-06",
  // Only /rx/* (PostHog proxy) runs the Worker; every other request is a plain static asset.
  "main": "worker/index.js",
  // Cloudflare Workers Builds uses wrangler preview for pull requests.
  "previews": {},
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/rx/*"]
  }
}
